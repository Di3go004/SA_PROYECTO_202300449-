# notification-service/.env.example
# Copiar a .env y completar. El .env real nunca se sube al repositorio.

# Base de datos propia (patrón Database per Microservice)
NOTIF_DB_HOST=postgres-db
NOTIF_DB_PORT=5432
NOTIF_DB_NAME=yousac_notifications_db
NOTIF_DB_USER=yousac
NOTIF_DB_PASS=cambiar_esta_clave

# Puertos
GRPC_PORT=50055
HTTP_PORT=3004

# URL pública del frontend, usada en los enlaces de los correos
APP_PUBLIC_URL=http://localhost:5173

# ── SMTP ──────────────────────────────────────────────────────
# Local: Mailpit, sin credenciales ni TLS
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# Producción con Gmail (contraseña de aplicación, no la del correo):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=tucorreo@gmail.com
#   SMTP_PASSWORD=xxxx xxxx xxxx xxxx
#   SMTP_USE_TLS=true

SMTP_FROM=no-reply@ingenieria.usac.edu.gt
SMTP_FROM_NAME=YoUSAC
