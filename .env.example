# ============================================================
# YoUSAC — Plantilla de variables de entorno
#
# Copiar a .env y completar antes de levantar el ecosistema:
#
#     cp .env.example .env
#
# El archivo .env NO se versiona (está en .gitignore). Este ejemplo sí, para que
# cualquiera sepa qué variables hace falta definir sin exponer sus valores.
#
# Los valores de abajo sirven para desarrollo local. Para el despliegue en la
# nube hay que cambiar TODAS las contraseñas y el JWT_SECRET.
# ============================================================

# ── PostgreSQL: auth, catálogo y notificaciones ──────────────
POSTGRES_USER=yousac
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=postgres

# ── MongoDB: reproducción y checkpoints ──────────────────────
MONGO_USER=yousac
MONGO_PASSWORD=cambiar_esta_clave
MONGO_DB=yousac_reproduction_db

# ── MySQL: analítica ─────────────────────────────────────────
MYSQL_ROOT_PASSWORD=cambiar_esta_clave_root
MYSQL_USER=yousac
MYSQL_PASSWORD=cambiar_esta_clave
MYSQL_DATABASE=yousac_analytics_db

# ── Redis: caché de catálogo y tendencias ────────────────────
# Vacío en local (Redis no está expuesto fuera de la red de Docker).
# En la nube conviene definirla.
REDIS_PASSWORD=

# ── Seguridad ────────────────────────────────────────────────
# Cadena larga y aleatoria. Generar una nueva para producción:
#   openssl rand -base64 48
JWT_SECRET=cambiar_por_una_cadena_larga_y_aleatoria
JWT_TTL=8h

# ── URLs públicas ────────────────────────────────────────────
# En local quedan como están. En la nube se reemplaza localhost por la IP
# externa o el dominio de la VM.
PUBLIC_HOST=localhost
APP_PUBLIC_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8080
MEDIA_PUBLIC_URL=http://localhost:8081

# ── Correo saliente ──────────────────────────────────────────
# Local: Mailpit captura los correos en una bandeja web (http://localhost:8025)
# sin entregarlos ni pedir credenciales.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=no-reply@ingenieria.usac.edu.gt
SMTP_FROM_NAME=YoUSAC

# Nube con Gmail. La contraseña de aplicación se genera en
# https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos)
# y NO es la contraseña de la cuenta:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=tucorreo@gmail.com
#   SMTP_PASSWORD=xxxxxxxxxxxxxxxx
#   SMTP_USE_TLS=true

# ── Entorno ──────────────────────────────────────────────────
NODE_ENV=development
ENV=development
