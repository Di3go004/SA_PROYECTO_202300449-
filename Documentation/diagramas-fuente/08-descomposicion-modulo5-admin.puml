@startuml descomposicion-modulo5
' ============================================================
' YoUSAC — Primera descomposición · Módulo 5
' Panel administrativo y carga masiva (RF-036 a RF-050)
' ============================================================
!theme plain
skinparam backgroundColor #FCF8FF
skinparam defaultFontName Inter
skinparam ArrowColor #06007C
skinparam actorBorderColor #06007C
skinparam usecaseBorderColor #196584

title Módulo 5 — Panel Administrativo y Carga Masiva

left to right direction

actor "Auxiliar" as aux
actor "Catedrático" as cat
actor "Administrador" as adm

aux <|-- cat
cat <|-- adm

rectangle "Panel Administrativo" {

  usecase "CU-09\nGestionar semestres" as cu09
  usecase "CU-10\nGestionar escuelas" as cu10
  usecase "CU-11\nGestionar cursos" as cu11
  usecase "CU-12\nAsignar docentes" as cu12
  usecase "CU-13\nPublicar grabación" as cu13
  usecase "CU-14\nCargar CSV" as cu14
  usecase "CU-15\nConsultar bitácora\nde cargas" as cu15

  usecase "Validar\npermisos por rol" as val
  usecase "Invocar procedimiento\nalmacenado" as sp
  usecase "Verificar dependencias\nantes de eliminar" as dep
  usecase "Parsear archivo\nRFC 4180" as parse
  usecase "Resolver docentes\npor correo" as resolve
  usecase "Aislar fila con\nSAVEPOINT" as savepoint
  usecase "Registrar error\nde fila" as errlog
  usecase "Notificar a\nestudiantes inscritos" as notif
  usecase "Omitir grabación\nya existente" as skip
}

aux --> cu09
aux --> cu10
aux --> cu11
aux --> cu12
aux --> cu13
aux --> cu14
aux --> cu15

' ── Inclusiones: siempre ocurren ──
cu09 ..> val : <<include>>
cu10 ..> val : <<include>>
cu11 ..> val : <<include>>
cu12 ..> val : <<include>>
cu13 ..> val : <<include>>
cu14 ..> val : <<include>>

cu09 ..> sp : <<include>>
cu10 ..> sp : <<include>>
cu11 ..> sp : <<include>>
cu12 ..> sp : <<include>>

cu14 ..> parse : <<include>>
cu14 ..> resolve : <<include>>
cu14 ..> savepoint : <<include>>

' ── Extensiones: ocurren bajo condición ──
cu09 <.. dep : <<extend>>\n[al eliminar]
cu10 <.. dep : <<extend>>\n[al eliminar]
cu11 <.. dep : <<extend>>\n[al eliminar]
cu14 <.. errlog : <<extend>>\n[fila inválida]
cu14 <.. skip : <<extend>>\n[video_url duplicada]
cu13 <.. notif : <<extend>>\n[hay inscritos]

note bottom of sp
  RF-049: toda escritura sobre
  entidades académicas pasa por
  un procedimiento almacenado.
end note

note bottom of savepoint
  RF-044: una fila inválida no
  aborta el resto del archivo.
end note

@enduml
