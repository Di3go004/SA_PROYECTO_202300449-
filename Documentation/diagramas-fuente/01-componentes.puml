@startuml componentes
' ============================================================
' YoUSAC — Diagrama de Componentes (Vista de Desarrollo)
' Actualizado: incluye caché Redis, notificaciones y servidor de medios.
' ============================================================
!theme plain
skinparam componentStyle rectangle
skinparam backgroundColor #FCF8FF
skinparam defaultFontName Inter
skinparam ArrowColor #06007C
skinparam componentBorderColor #06007C
skinparam databaseBorderColor #196584
skinparam packageBorderColor #777684

title YoUSAC — Vista de Componentes

actor "Usuario\n(navegador)" as user

package "Cliente" {
  [Frontend\nReact + Vite\n:5173] as fe
}

package "Borde — único punto de entrada" {
  [API Gateway\nExpress · Node\n:8080] as gw
}

package "Microservicios — tráfico interno solo gRPC" {
  [auth-service\nNestJS · TypeScript\n:50052] as auth
  [catalog-service\nNestJS · TypeScript\n:50053] as cat
  [reproduction-service\nGo\n:50051] as rep
  [analytics-service\nPython · FastAPI\n:50054] as ana
  [notification-service\nPython\n:50055] as notif
}

package "Infraestructura de apoyo" {
  [media-server\nnginx\n:8081] as media
  [Servidor SMTP\nMailpit / Gmail] as smtp
}

database "PostgreSQL 16" as pg {
  [yousac_auth_db] as pgauth
  [yousac_catalog_db] as pgcat
  [yousac_notifications_db] as pgnotif
}
database "MongoDB 7\nreproducción" as mongo
database "MySQL 8\nanalítica" as mysql
database "Redis 7\ncaché" as redis

' ── Tráfico norte-sur (REST) ──
user --> fe
fe --> gw : REST/HTTPS\nJWT + Session Cookie
fe ..> media : HTTP Range\n(streaming de video)

' ── Tráfico este-oeste (gRPC) ──
gw --> auth  : gRPC
gw --> cat   : gRPC
gw --> rep   : gRPC
gw --> ana   : gRPC
gw --> notif : gRPC

cat   --> auth  : gRPC\nresolver docentes\ny correos de inscritos
cat   --> notif : gRPC\navisar nueva clase
auth  --> notif : gRPC\ncorreo de bienvenida
ana   --> rep   : gRPC\nsincronizar métricas

' ── Persistencia ──
auth  --> pgauth
cat   --> pgcat
notif --> pgnotif
rep   --> mongo
ana   --> mysql
ana   --> redis : caché con TTL

notif --> smtp : SMTP

note right of gw
  Ningún cliente externo alcanza
  un microservicio directamente.
  El gateway valida el JWT y
  traduce REST a gRPC.
end note

note bottom of redis
  Acelerador, no dependencia:
  si Redis cae, analytics-service
  degrada a consultar MySQL.
end note

@enduml
