@startuml secuencia-notificaciones
' ============================================================
' YoUSAC — Secuencia: notificación de nueva clase publicada
' Muestra por qué el envío es asíncrono respecto de la publicación.
' ============================================================
!theme plain
skinparam backgroundColor #FCF8FF
skinparam defaultFontName Inter
skinparam ArrowColor #06007C
skinparam ParticipantBorderColor #06007C
skinparam DatabaseBorderColor #196584
skinparam NoteBackgroundColor #F5F2FC
skinparam NoteBorderColor #196584

title Aviso por correo al publicar una grabación

actor "Administrador" as admin
participant "API Gateway" as gw
participant "catalog-service" as cat
participant "auth-service" as auth
participant "notification-service" as notif
database "catalog_db" as dbcat
database "auth_db" as dbauth
database "notifications_db" as dbnotif
participant "Servidor SMTP" as smtp
actor "Estudiante\ninscrito" as est

admin -> gw : PUT /api/admin/recordings/{id}/publish
activate gw
gw -> gw : validateJWT + requireAdminRole
gw -> cat : gRPC SetRecordingPublished
deactivate gw

activate cat
cat -> dbcat : SELECT fn_set_recording_published(id, true)
dbcat --> cat : título, curso, docente
note right of cat
  La publicación ya está confirmada.
  Todo lo que sigue es accesorio.
end note

group Resolución de destinatarios
  cat -> dbcat : SELECT fn_get_enrolled_student_ids(course_id)
  dbcat --> cat : [student_id]
  note right of dbcat
    Solo identificadores: los correos
    viven en auth_db y esta base no
    conoce datos de contacto.
  end note

  cat -> auth : gRPC ResolveStudentEmails(ids) + JWT
  activate auth
  auth -> dbauth : SELECT ... WHERE is_active AND NOT is_blocked
  dbauth --> auth : correos
  auth --> cat : [{id, email, full_name}]
  deactivate auth
end

cat -> notif : gRPC SendNewRecordingAlert(destinatarios)
activate notif

loop por cada destinatario
  notif -> dbnotif : CALL sp_queue_notification(...)
  note right of dbnotif
    El SP rechaza correos ajenos al
    dominio institucional. Un trigger
    registra el alta en la auditoría.
  end note
  dbnotif --> notif : notification_id
  notif -> notif : lanza hilo de envío
end

notif --> cat : SendResponse(queued=true)
deactivate notif

cat --> gw : "Grabación publicada exitosamente"
deactivate cat
gw --> admin : 200 OK

note over cat, notif
  La respuesta al administrador no espera al SMTP.
  Un correo lento no puede hacer lenta una publicación,
  y un SMTP caído no puede impedirla.
end note

== Entrega asíncrona, en segundo plano ==

notif -> smtp : SMTP send
activate smtp

alt entrega correcta
  smtp --> notif : 250 OK
  notif -> dbnotif : CALL sp_mark_notification_sent(id)
  dbnotif -> dbnotif : trigger → auditoría\npendiente → enviado
  smtp -> est : correo con enlace a la clase
else fallo de entrega
  smtp --> notif : error
  notif -> dbnotif : CALL sp_mark_notification_failed(id, motivo)
  dbnotif -> dbnotif : trigger → auditoría\npendiente → fallido
  note right of dbnotif
    El fallo queda registrado con su
    motivo, pero la grabación sigue
    publicada.
  end note
end
deactivate smtp

@enduml
